from __future__ import annotations

import numpy as np

from .base import OpticalElement


class Mirror(OpticalElement):

    def interact(
        self,
        ray,
    ):
        """
        Specular reflection.
        """

        n = self.transform.normal
        n = n / np.linalg.norm(n)

        d = ray.direction

        ray.direction = (
            d
            - 2.0 * np.dot(d, n) * n
        )

        ray.direction /= np.linalg.norm(
            ray.direction
        )
