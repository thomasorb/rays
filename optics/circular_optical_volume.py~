from __future__ import annotations

from .optical_volume import (
    OpticalVolume
)


class CircularOpticalVolume(
    OpticalVolume
):

    def contains_world_point(
        self,
        point,
    ):

        if not self.contains_between_surfaces(
            point
        ):
            return False

        local = (
            self.front.transform
            .world_to_local_point(
                point
            )
        )

        r2 = (
            local[0]**2
            +
            local[1]**2
        )

        return (
            r2
            <=
            (self.diameter / 2)**2
        )
