from __future__ import annotations

import numpy as np

from .planar import PlanarElement


class OpticalInterface(
    PlanarElement
):
    """
    Interface between two media.

    Examples
    --------

    Air -> Glass

        n1 = 1.0
        n2 = 1.5
        R  = 0.0
        T  = 1.0

    Mirror

        n1 = 1.0
        n2 = 1.0
        R  = 1.0
        T  = 0.0

    Beam splitter

        n1 = 1.0
        n2 = 1.5
        R  = 0.5
        T  = 0.5
    """

    def __init__(
        self,
        n1,
        n2,
        R=0.0,
        T=1.0,
        phase_reflection=np.pi / 2,
        max_generation_depth=10,
        *args,
        **kwargs,
    ):

        super().__init__(
            *args,
            **kwargs
        )

        self.n1 = float(n1)
        self.n2 = float(n2)

        self.R = float(R)
        self.T = float(T)

        self.phase_reflection = (
            phase_reflection
        )

        self.max_generation_depth = (
            max_generation_depth
        )

    # ==================================================
    # Snell
    # ==================================================

    def refract(
        self,
        direction,
        normal,
        n_in,
        n_out,
    ):

        cos_i = (
            -np.dot(
                normal,
                direction,
            )
        )

        eta = (
            n_in / n_out
        )

        k = (
            1.0
            -
            eta**2
            * (
                1.0
                - cos_i**2
            )
        )

        #
        # Total internal reflection
        #

        if k < 0.0:

            return None

        return (
            eta * direction
            +
            (
                eta * cos_i
                - np.sqrt(k)
            )
            * normal
        )

    # ==================================================
    # Interaction
    # ==================================================

    def interact(
        self,
        ray,
    ):

        if (
            ray.generation
            >= self.max_generation_depth
        ):
            return [ray]

        #
        # Orient the normal
        #
        # Normal points against
        # the incoming ray.
        #

        normal = (
            self.normal.copy()
        )

        if np.dot(
            ray.direction,
            normal,
        ) > 0:

            normal *= -1.0

        #
        # Determine which side
        # the ray is coming from.
        #

        if np.isclose(
            ray.current_index,
            self.n1,
        ):

            n_in = self.n1
            n_out = self.n2

        elif np.isclose(
            ray.current_index,
            self.n2,
        ):

            n_in = self.n2
            n_out = self.n1

        else:

            raise RuntimeError(
                f"Ray index "
                f"{ray.current_index}"
                f" does not match "
                f"interface indices "
                f"{self.n1}, {self.n2}"
            )

        rays = []

        # ==========================================
        # Reflection
        # ==========================================

        if self.R > 0:

            reflected = (
                ray.clone()
            )

            reflected.branch_id += (
                ".R"
            )

            reflected.generation += 1

            d = reflected.direction

            reflected.direction = (
                d
                -
                2.0
                * np.dot(
                    d,
                    normal
                )
                * normal
            )

            reflected.direction /= (
                np.linalg.norm(
                    reflected.direction
                )
            )

            reflected.complex_amplitude *= (
                np.sqrt(self.R)
                *
                np.exp(
                    1j
                    * self.phase_reflection
                )
            )

            #
            # Reflection stays
            # in the same medium.
            #

            reflected.current_index = (
                n_in
            )

            rays.append(
                reflected
            )

        # ==========================================
        # Transmission
        # ==========================================

        if self.T > 0:

            dT = self.refract(
                ray.direction,
                normal,
                n_in,
                n_out,
            )

            if dT is not None:

                transmitted = (
                    ray.clone()
                )

                transmitted.branch_id += (
                    ".T"
                )

                transmitted.generation += 1

                transmitted.direction = (
                    dT
                    /
                    np.linalg.norm(
                        dT
                    )
                )

                transmitted.complex_amplitude *= (
                    np.sqrt(
                        self.T
                    )
                )

                #
                # Ray switches medium
                #

                transmitted.current_index = (
                    n_out
                )

                rays.append(
                    transmitted
                )

        ray.is_alive = False

        return rays

    # ==================================================
    # Report
    # ==================================================

    def __repr__(
        self,
    ):

        return (
            f"{self.__class__.__name__}"
            f"(n1={self.n1}, "
            f"n2={self.n2}, "
            f"R={self.R}, "
            f"T={self.T})"
        )
